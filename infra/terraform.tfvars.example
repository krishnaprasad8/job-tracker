# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Generate the token at: Hetzner Console -> your project -> Security ->
# API tokens -> Generate API token -> Read & Write.

hcloud_token = "paste-your-hetzner-api-token-here"

# Optional overrides:
# server_type     = "cx33"
# location        = "nbg1"
# allowed_ssh_ips = ["203.0.113.4/32"]
