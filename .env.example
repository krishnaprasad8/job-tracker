# Template for environment variables. This file IS committed to git.
#
# Copy it to .env and fill in real values:
#     cp .env.example .env
#
# .env is gitignored, so your real password never reaches GitHub.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/job_tracker
