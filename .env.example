# Template for environment variables. This file IS committed to git.
#
# Copy it to .env and fill in real values:
#     cp .env.example .env
#
# .env is gitignored, so your real password never reaches GitHub.

# PostgreSQL connection string.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE_NAME
#
# On a Homebrew Mac the local install uses "trust" auth, so the password can be
# left out entirely and USER is your Mac username:
#   postgresql+psycopg2://yourname@localhost:5432/job_tracker
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/job_tracker
